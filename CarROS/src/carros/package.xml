<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carros</name>
  <version>0.0.1</version>
  <description>Baja car ROS 2 sensor layer</description>
  <maintainer email="jakethrun@gmail.com">turtle</maintainer>
