[Unit]
Description=CarROS sensor layer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/CarROS
Environment=HOME=/home/ubuntu
Environment=ROS_DOMAIN_ID=0
ExecStart=/home/ubuntu/CarROS/scripts/start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
